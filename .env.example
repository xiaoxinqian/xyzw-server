# 服务器配置
PORT=3000
NODE_ENV=production

# JWT 密钥（部署时必须改为随机字符串，建议64位）
JWT_SECRET=change-me-to-random-64-char-string

# AES-256-CBC 加密密钥（必须32字节，部署时改为随机值）
AES_KEY=change-me-32-byte-key-here-1234567890

# 数据库路径
DB_PATH=/opt/xyzw-server/data/xyzw.db

# 管理员初始账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
